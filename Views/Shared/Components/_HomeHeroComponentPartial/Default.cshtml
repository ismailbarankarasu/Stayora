<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="hero-text">
                    <h1>Bir sonraki durağını keşfet.</h1>
                    <p>
                        Şehrini ve seyahat tarihlerini seç,
                        sana uygun otelleri keşfet.
                        Konaklamanı Stayora ile planla.
                    </p>
                    <a href="#hotel-search" class="primary-btn">
                        Otel Ara
                    </a>
                </div>
            </div>

            <div class="col-xl-4 col-lg-5 offset-xl-2 offset-lg-1">
                @await Component.InvokeAsync("_HomeSearchComponentPartial")
            </div>
        </div>
    </div>

    <div class="hero-slider owl-carousel">
        <div class="hs-item set-bg"
             data-setbg="@Url.Content("~/sona-master/img/hero/hero-1.jpg")">
        </div>

        <div class="hs-item set-bg"
             data-setbg="@Url.Content("~/sona-master/img/hero/hero-2.jpg")">
        </div>

        <div class="hs-item set-bg"
             data-setbg="@Url.Content("~/sona-master/img/hero/hero-3.jpg")">
        </div>
    </div>
</section>