                        <ul>
                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   style="color: inherit;">
                                    Ana Sayfa
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   asp-fragment="hotel-search"
                                   style="color: inherit;">
