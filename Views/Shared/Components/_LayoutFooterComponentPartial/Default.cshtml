                                </a>
                            </li>

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   asp-fragment="about"
                                   style="color: inherit;">
                                    Hakkımızda
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   asp-fragment="how-it-works"
                                   style="color: inherit;">
                                    Nasıl Çalışır?
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 offset-lg-1">
                    <div class="ft-contact">
                        <h6>Konaklamanı Planla</h6>

                        <ul>
                            <li>
                                Şehrini ve seyahat tarihlerini belirle.
                            </li>
                            <li>
