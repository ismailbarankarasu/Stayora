                        </p>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="co-text">
                        <p>
                            Template by
                            <a href="https://colorlib.com"
                               target="_blank"
                               rel="noopener noreferrer">
                                Colorlib
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
